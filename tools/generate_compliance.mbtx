import {
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
}

///|
let canonical_fixtures : Array[String] = [
  "basic.json",
  "benchmarks.json",
  "boolean.json",
  "current.json",
  "escape.json",
  "filters.json",
  "functions.json",
  "identifiers.json",
  "indices.json",
  "literal.json",
  "multiselect.json",
  "pipe.json",
  "slice.json",
  "syntax.json",
  "unicode.json",
  "wildcard.json",
]

///|
fn main raise {
  let args = @env.args()
  if args.length() != 3 {
    println(
      "usage: moon run tools/generate_compliance.mbtx <fixture-dir> <output.mbt>",
    )
    return
  }
  let fixture_dir = args[1]
  let output_path = args[2]
  let output = StringBuilder()
  output.write_string(
    "// Generated by tools/generate_compliance.mbtx. Do not edit by hand.\n",
  )
  output.write_string("///|\n")
  output.write_string(
    "let compliance_fixture_sources : Array[(String, String)] = [\n",
  )
  for filename in canonical_fixtures {
    let path = fixture_dir + "/" + filename
    let source = @fs.read_file_to_string(path)
    output.write_string("  (")
    output.write_string(filename.escape())
    output.write_string(", ")
    output.write_string(source.escape())
    output.write_string("),\n")
  }
  output.write_string("]\n")
  @fs.write_string_to_file(output_path, output.to_string())
  println(
    "generated \{canonical_fixtures.length()} fixtures at \{output_path}",
  )
}
