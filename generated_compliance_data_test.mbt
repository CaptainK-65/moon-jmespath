    "wildcard.json", "[{\r\n    \"given\": {\r\n        \"foo\": {\r\n            \"bar\": {\r\n                \"baz\": \"val\"\r\n            },\r\n            \"other\": {\r\n                \"baz\": \"val\"\r\n            },\r\n            \"other2\": {\r\n                \"baz\": \"val\"\r\n            },\r\n            \"other3\": {\r\n                \"notbaz\": [\"a\", \"b\", \"c\"]\r\n            },\r\n            \"other4\": {\r\n                \"notbaz\": [\"a\", \"b\", \"c\"]\r\n            },\r\n            \"other5\": {\r\n                \"other\": {\r\n                    \"a\": 1,\r\n                    \"b\": 1,\r\n                    \"c\": 1\r\n                }\r\n            }\r\n        }\r\n    },\r\n    \"cases\": [\r\n         {\r\n            \"expression\": \"foo.*.baz\",\r\n            \"result\": [\"val\", \"val\", \"val\"]\r\n         },\r\n         {\r\n            \"expression\": \"foo.bar.*\",\r\n            \"result\": [\"val\"]\r\n         },\r\n         {\r\n            \"expression\": \"foo.*.notbaz\",\r\n            \"result\": [[\"a\", \"b\", \"c\"], [\"a\", \"b\", \"c\"]]\r\n         },\r\n         {\r\n            \"expression\": \"foo.*.notbaz[0]\",\r\n            \"result\": [\"a\", \"a\"]\r\n         },\r\n         {\r\n            \"expression\": \"foo.*.notbaz[-1]\",\r\n            \"result\": [\"c\", \"c\"]\r\n         }\r\n    ]\r\n}, {\r\n    \"given\": {\r\n        \"foo\": {\r\n            \"first-1\": {\r\n                \"second-1\": \"val\"\r\n            },\r\n            \"first-2\": {\r\n                \"second-1\": \"val\"\r\n            },\r\n            \"first-3\": {\r\n                \"second-1\": \"val\"\r\n            }\r\n        }\r\n    },\r\n    \"cases\": [\r\n         {\r\n            \"expression\": \"foo.*\",\r\n            \"result\": [{\"second-1\": \"val\"}, {\"second-1\": \"val\"},\r\n                       {\"second-1\": \"val\"}]\r\n         },\r\n         {\r\n            \"expressio