foo[].bar[].[baz]\",\r\n           \"result\": [[1], [3], [5], [7]]\r\n        },\r\n        {\r\n           \"expression\": \"foo[].bar[].[baz, qux][]\",\r\n           \"result\": [1, 2, 3, 4, 5, 6, 7, 8]\r\n        }\r\n    ]\r\n},\r\n{\r\n    \"given\": {\r\n        \"foo\": {\r\n            \"baz\": [\r\n                {\r\n                    \"bar\": \"abc\"\r\n                }, {\r\n                    \"bar\": \"def\"\r\n                }\r\n            ],\r\n            \"qux\": [\"zero\"]\r\n        }\r\n    },\r\n    \"cases\": [\r\n        {\r\n           \"expression\": \"foo.[baz[*].bar, qux[0]]\",\r\n           \"result\": [[\"abc\", \"def\"], \"zero\"]\r\n        }\r\n    ]\r\n},\r\n{\r\n    \"given\": {\r\n        \"foo\": {\r\n            \"baz\": [\r\n                {\r\n                    \"bar\": \"a\",\r\n                    \"bam\": \"b\",\r\n                    \"boo\": \"c\"\r\n                }, {\r\n                    \"bar\": \"d\",\r\n                    \"bam\": \"e\",\r\n                    \"boo\": \"f\"\r\n                }\r\n            ],\r\n            \"qux\": [\"zero\"]\r\n        }\r\n    },\r\n    \"cases\": [\r\n        {\r\n           \"expression\": \"foo.[baz[*].[bar, boo], qux[0]]\",\r\n           \"result\": [[[\"a\", \"c\" ], [\"d\", \"f\" ]], \"zero\"]\r\n        }\r\n    ]\r\n},\r\n{\r\n    \"given\": {\r\n        \"foo\": {\r\n            \"baz\": [\r\n                {\r\n                    \"bar\": \"a\",\r\n                    \"bam\": \"b\",\r\n                    \"boo\": \"c\"\r\n                }, {\r\n                    \"bar\": \"d\",\r\n                    \"bam\": \"e\",\r\n                    \"boo\": \"f\"\r\n                }\r\n            ],\r\n            \"qux\": [\"zero\"]\r\n        }\r\n    },\r\n    \"cases\": [\r\n        {\r\n           \"expression\": \"foo.[baz[*].not_there || baz[*].bar, qux[0]]\",\r\n           \"result\": [[\"a\", \"d\"], \"zero\"]\r\n        }\r\n    ]\r\n},\r\n{