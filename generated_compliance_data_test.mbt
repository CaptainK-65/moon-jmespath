    "unicode.json", "[\r\n    {\r\n        \"given\": {\"foo\": [{\"✓\": \"✓\"}, {\"✓\": \"✗\"}]},\r\n        \"cases\": [\r\n            {\r\n                \"expression\": \"foo[].\\\"✓\\\"\",\r\n                \"result\": [\"✓\", \"✗\"]\r\n            }\r\n        ]\r\n    },\r\n    {\r\n        \"given\": {\"☯\": true},\r\n        \"cases\": [\r\n            {\r\n                \"expression\": \"\\\"☯\\\"\",\r\n                \"result\": true\r\n            }\r\n        ]\r\n    },\r\n    {\r\n        \"given\": {\"♪♫•*¨*•.¸¸❤¸¸.•*¨*•♫♪\": true},\r\n        \"cases\": [\r\n            {\r\n                \"expression\": \"\\\"♪♫•*¨*•.¸¸❤¸¸.•*¨*•♫♪\\\"\",\r\n                \"result\": true\r\n            }\r\n        ]\r\n    },\r\n    {\r\n        \"given\": {\"☃\": true},\r\n        \"cases\": [\r\n            {\r\n                \"expression\": \"\\\"☃\\\"\",\r\n                \"result\": true\r\n            }\r\n        ]\r\n    }\r\n]\r\n",
  ),
